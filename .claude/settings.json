{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "worktree": { "bgIsolation": "none" },
  "env": {
    "CLAUDE_CODE_GIT_BASH_PATH": "C:\\Program Files\\Git\\bin\\bash.exe"
  },
  "permissions": {
    "//": "Precedence is deny -> ask -> allow, first match wins; specificity is ignored. Anything matching none of the three falls back to defaultMode. That is why the ask rules below still prompt even in acceptEdits.",
    "defaultMode": "acceptEdits",
    "allow": [
      "Read(./**)",
      "Glob",
      "Grep",
      "Write(core/**)",
      "Write(analysis/**)",
      "Write(experiments/**)",
      "Write(docs/**)",
      "Edit(core/**)",
      "Edit(analysis/**)",
      "Edit(experiments/**)",
      "Edit(docs/**)",
      "Bash(dotnet:*)",
      "Bash(python3:*)",
      "Bash(python:*)",
      "Bash(pytest:*)",
      "Bash(pip install:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(cut:*)",
      "Bash(diff:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(test:*)",
      "Bash(cd:*)",
      "Bash(pwd:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(chmod:*)",
      "Bash(bash:*)",
      "Bash(adb logcat:*)",
      "Bash(adb devices:*)",
      "Write(results/**)"
    ],
    "ask": [
      "Edit(unity/**)",
      "Write(unity/**)",
      "Edit(robot/**)",
      "Write(robot/**)",
      "Edit(.claude/**)",
      "Edit(.github/**)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(gh:*)",
      "Bash(rm:*)",
      "Bash(adb install:*)",
      "Bash(adb uninstall:*)"
    ],
    "deny": [
      "Edit(results/**)",
      "Edit(core/testdata/**)",
      "Edit(unity/TeleopVR/Library/**)",
      "Edit(build/**)",
      "Bash(rm -rf:*)",
      "Bash(git commit --amend:*)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard:*)",
      "Bash(git filter-branch:*)",
      "Bash(git push --force:*)",
      "Bash(curl:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ./scripts/hooks/core-guard.sh"
          }
        ]
      }
    ]
  }
}