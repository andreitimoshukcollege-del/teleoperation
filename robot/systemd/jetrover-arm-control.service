[Unit]
Description=jetrover_arm_control's robot_controller_manager -- real servo bus driver
After=multi-user.target

[Service]
Type=simple
User=jetson
# See jetrover-relay.service's own comment on why both ROS setup scripts are sourced explicitly
# here rather than relying on ~/.bashrc (which ExecStart bypasses, and which is stale anyway).
ExecStart=/bin/bash -c 'source /opt/ros/foxy/setup.bash && source /home/jetson/projects/jetrover-teleop-ros/install/setup.bash && export ROS_LOCALHOST_ONLY=1 PYTHONUNBUFFERED=1 && exec ros2 run jetrover_arm_control robot_controller_manager'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
