<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Teleop.Core\Teleop.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Explicit Link (rather than a glob) because MSBuild's default relative-path handling for
         an Include outside the project directory ("..") does not reliably preserve the
         "testdata/golden/" structure under the output directory otherwise. -->
    <None Include="..\testdata\golden\basic-session.tlog" CopyToOutputDirectory="PreserveNewest" Link="testdata\golden\basic-session.tlog" />
    <!-- The learned predictor's golden (docs/adr/0025), written by the trainer's `armpred golden-learned`. -->
    <None Include="..\testdata\learned\golden-v3.json" CopyToOutputDirectory="PreserveNewest" Link="testdata\learned\golden-v3.json" />
    <None Include="..\testdata\learned\finetune-pilot2-early7.weights" CopyToOutputDirectory="PreserveNewest" Link="testdata\learned\finetune-pilot2-early7.weights" />
    <!-- Layout v4's golden (docs/adr/0028), written by the trainer's `armpred golden-learned-v4`, and its model's weights (format 2). -->
    <None Include="..\testdata\learned\golden-v4.json" CopyToOutputDirectory="PreserveNewest" Link="testdata\learned\golden-v4.json" />
    <None Include="..\testdata\learned\fr3-*.weights" CopyToOutputDirectory="PreserveNewest" Link="testdata\learned\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
