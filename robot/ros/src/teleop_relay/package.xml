<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>teleop_relay</name>
  <version>0.1.0</version>
  <description>
    Bridges teleoperation's Teleop.RobotHost (a real IRobotPlant/ITransport endpoint) to
    jetrover_arm_control's existing ROS topics, over a local Unix domain socket. See
    teleoperation's docs/adr/0007-jetrover-plant-and-robot-host.md.
  </description>
  <maintainer email="jetson@todo.todo">jetson</maintainer>
  <license>MIT</license>

  <exec_depend>jetrover_arm_control</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
