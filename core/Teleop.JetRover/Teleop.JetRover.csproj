<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Teleop.Core\Teleop.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Same constraint as Teleop.Core: this is compiled by both dotnet (Teleop.RobotHost) and
         Unity (as a second local package alongside com.teleop.core). Do NOT retarget to net8.0
         and do NOT raise LangVersion: Unity 2022.3 is C# 9 / .NET Standard 2.1. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>

    <!-- Zero PackageReference entries, by design, same reasoning as Teleop.Core.csproj. -->
  </PropertyGroup>

</Project>
